# Django
DEBUG=True
# Generate a real one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-characters-long
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL example)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=edumanage
DB_USER=edumanage_user
DB_PASSWORD=your-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432

# For quick local testing without MySQL installed, set this to True
# and the project will fall back to SQLite automatically.
USE_SQLITE=False

# JWT
ACCESS_TOKEN_LIFETIME_MIN=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Channels / Redis (used for chat websockets)
REDIS_URL=redis://127.0.0.1:6379/0

# Payment Gateway
# This project ships with a PLUGGABLE gateway abstraction (apps/courses/payments.py).
# Set PAYMENT_GATEWAY=mock to test the full purchase flow with no external account.
# Set PAYMENT_GATEWAY=razorpay to accept real UPI / Google Pay / PhonePe / Paytm payments
# (Razorpay is the standard Indian aggregator that supports all four of those rails
# under a single integration + webhook).
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
